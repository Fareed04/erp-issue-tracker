{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information including display name, avatar, and notification settings.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "description": "The user's full name." },
        "photoURL": { "type": "string", "description": "URL to the user's profile picture." },
        "email": { "type": "string", "description": "The user's account email address." },
        "notificationEmail": { "type": "string", "description": "Custom email address for receiving task notifications." }
      },
      "required": ["displayName", "email"]
    },
    "Issue": {
      "title": "Issue",
      "description": "A task, bug, or issue in the ERP system.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Short summary of the issue." },
        "description": { "type": "string", "description": "Detailed description." },
        "type": { "type": "string", "enum": ["task", "bug", "issue"] },
        "status": { "type": "string", "enum": ["draft", "todo", "in_progress", "blocked", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "assigneeUid": { "type": "string", "description": "UID of the assigned user." },
        "reporterUid": { "type": "string", "description": "UID of the user who reported the issue." },
        "delay_cause": { "type": "string", "description": "Reason for delay if blocked." },
        "links": {
          "type": "array",
          "description": "Dependencies and links to other issues.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["blocks", "blocked_by", "is_blocked_by", "relates_to"] },
              "targetIssueId": { "type": "string" }
            },
            "required": ["id", "type", "targetIssueId"]
          }
        },
        "assignedAt": { "type": "string", "format": "date-time", "description": "Timestamp when the issue was assigned." },
        "totalLoggedHours": { "type": "number", "description": "Total hours logged across all time entries for this issue." },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "status", "priority", "reporterUid", "created_at", "updated_at"]
    },
    "TimeLog": {
      "title": "Time Log Entry",
      "description": "A record of hours spent by a user on a specific issue.",
      "type": "object",
      "properties": {
        "issueId": { "type": "string", "description": "ID of the parent issue." },
        "userId": { "type": "string", "description": "UID of the user who logged the time." },
        "userName": { "type": "string", "description": "Display name of the user who logged the time." },
        "userPhoto": { "type": "string", "description": "Photo URL of the user who logged the time." },
        "hours": { "type": "number", "description": "Number of hours logged." },
        "note": { "type": "string", "maxLength": 500, "description": "Optional note describing the work done." },
        "date": { "type": "string", "description": "Date the work was performed (YYYY-MM-DD)." },
        "timestamp": { "type": "string", "format": "date-time", "description": "ISO timestamp when the entry was created." }
      },
      "required": ["issueId", "userId", "userName", "hours", "date", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/issues/{issueId}": {
      "schema": "Issue",
      "description": "Collection of system issues."
    },
    "/issues/{issueId}/timeLogs/{timeLogId}": {
      "schema": "TimeLog",
      "description": "Subcollection of time tracking entries logged against an issue."
    }
  }
}
